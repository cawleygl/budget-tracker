<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Budgets</title>
</head>
<body>
	<h1>All Budgets</h1>
	<ul>
		<% budgets.forEach(budget => { %>
			<li><a href="/budgets/<%= budget.id %>"></href><%= budget.name %> - <%= budget.amount %></a></li>
		<% }) %>
	</ul>
</body>
</html>