<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Budgets</title>
</head>
<body>
	<h1><%= budget.name %></h1>
	<ul>
		<% costs.forEach(cost => { %>
			<li><%= cost.name %> - <%= cost.amount %> - <%= cost.expiration %></li>
		<% }) %>
	</ul>
</body>
</html>